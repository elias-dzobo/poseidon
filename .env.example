# Copernicus Data Space Ecosystem credentials
# Register free at: https://dataspace.copernicus.eu
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_password

# Optional: Hugging Face token (for gated models)
HF_TOKEN=hf_...

# Optional: paths override (defaults to config/settings.yaml)
POSEIDON_SETTINGS=config/settings.yaml
POSEIDON_OUTPUT_DIR=outputs
